# fastlane/Fastfile
# CalmTrack 自动打包与分发
#   ios build      —— CI 模拟器构建验证（无签名）
#   ios archive    —— 本机真机 Release + Development 签名 ipa（Automatic signing）
#   ios package    —— 统一打包/分发入口（scripts/package.sh 调用）：
#                     env=development|appstore（签名环境）
#                     distribute=none|testflight|appstore（分发目标，需 env=appstore）
#                     version=可选（覆盖 MARKETING_VERSION，本次生效）；build 号自动递增
#   ios beta       —— 便捷别名：env=appstore + distribute=testflight
#   ios appstore   —— 便捷别名：env=appstore + distribute=appstore
#   ios test_build —— CI 测试编译验证
#
# App Store Connect API Key：
#   创建：App Store Connect → 用户和访问 → 集成 → App Store Connect API → 生成密钥（.p8）
#   配置：cp fastlane/.env.example fastlane/.env 后填入真实值（fastlane/.env 已 gitignore）
#   本文件只读环境变量，不写死密钥；占位值仅在未配置时兜底并导致显式报错。

default_platform(:ios)

platform :ios do
  desc "模拟器构建验证（CI 用；无需签名）"
  lane :build do
    xcodebuild(
      project: "CalmTrack.xcodeproj",
      scheme: "CalmTrack",
      destination: "generic/platform=iOS Simulator",
      derivedDataPath: "build/DerivedData",
      code_signing: false
    )
  end

  desc "真机 Release archive 并导出 Development 签名 ipa（本机；Automatic signing；旧命令，推荐改用 package）"
  lane :archive do
    gym(
      scheme: "CalmTrack",
      clean: true,
      configuration: "Release",
      export_method: "development",
      export_options: {
        method: "development",
        signingStyle: "automatic",
        teamID: "53353F8EY8"
      },
      output_directory: "build/ipa",
      output_name: "CalmTrack"
    )
  end

  desc "构建并编译测试（CI 用；模拟器，无签名）"
  lane :test_build do
    xcodebuild(
      project: "CalmTrack.xcodeproj",
      scheme: "CalmTrack",
      destination: "generic/platform=iOS Simulator",
      derivedDataPath: "build/DerivedData",
      code_signing: false,
      build_for_testing: true
    )
  end

  desc "统一打包/分发：env=development|appstore；distribute=none|testflight|appstore；version 可选；build 号自动递增"
  lane :package do |options|
    env = (options[:env] || "development").to_s
    distribute = (options[:distribute] || "none").to_s
    version = options[:version]&.to_s

    unless %w[development appstore].include?(env)
      UI.user_error!("env 必须是 development 或 appstore，收到: #{env}")
    end
    unless %w[none testflight appstore].include?(distribute)
      UI.user_error!("distribute 必须是 none/testflight/appstore，收到: #{distribute}")
    end
    if distribute != "none" && env != "appstore"
      UI.user_error!("distribute=#{distribute} 需要 env=appstore（App Store 签名），当前 env=#{env}")
    end

    build_number = increment_build_number
    suffix = [env, version, build_number].compact.join("-")
    xcargs = version ? "MARKETING_VERSION=#{version}" : nil

    # 分发前需要 App Store Connect 访问（API key + match Distribution 证书）
    if distribute != "none"
      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] || "REPLACE_WITH_KEY_ID",
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"] || "REPLACE_WITH_ISSUER_ID",
        key_filepath: ENV["APP_STORE_CONNECT_API_KEY_FILEPATH"] || "REPLACE_WITH_KEY_FILEPATH",
        in_house: false
      )
      match(type: "appstore", readonly: true)
    end

    if env == "appstore"
      build_app(
        scheme: "CalmTrack",
        export_method: "app-store-connect",
        output_directory: "build/ipa",
        output_name: "CalmTrack-#{suffix}",
        xcargs: xcargs
      )
    else
      gym(
        scheme: "CalmTrack",
        clean: true,
        configuration: "Release",
        export_method: "development",
        export_options: {
          method: "development",
          signingStyle: "automatic",
          teamID: "53353F8EY8"
        },
        output_directory: "build/ipa",
        output_name: "CalmTrack-#{suffix}",
        xcargs: xcargs
      )
    end

    case distribute
    when "testflight"
      upload_to_testflight(skip_waiting_for_build_processing: true)
      UI.message("已上传 TestFlight")
    when "appstore"
      upload_to_app_store(
        skip_metadata: true,
        skip_screenshots: true,
        skip_app_version_update: true,
        force: true
      )
      UI.message("已上传 App Store Connect（App 信息/合规需在 ASC 手动确认后提交审核）")
    end

    UI.message("完成：build/ipa/CalmTrack-#{suffix}.ipa（build ##{build_number}#{version ? ", version #{version}" : ""}）")
  end

  desc "上传 TestFlight（便捷别名：package env=appstore distribute=testflight）"
  lane :beta do
    package(env: "appstore", distribute: "testflight")
  end

  desc "上传 App Store（便捷别名：package env=appstore distribute=appstore）"
  lane :appstore do
    package(env: "appstore", distribute: "appstore")
  end
end
