# fastlane/Fastfile
# CalmTrack 自动打包：本机真机 archive+ipa；CI 走 build lane（无签名验证）。
#
# 升级路线（接入 TestFlight 后启用）：
#   lane :beta do
#     build_app(scheme: "CalmTrack", export_method: "app-store-connect")
#     upload_to_testflight(skip_waiting_for_build_processing: true)
#   end
# 届时建议切换 fastlane match 管理证书，并把 App Store Connect API key 放入
# GitHub Secrets（APP_STORE_CONNECT_API_KEY_*），CI 即可全自动分发。

default_platform(:ios)

platform :ios do
  desc "模拟器构建验证（CI 用；无需签名）"
  lane :build do
    xcodebuild(
      project: "CalmTrack.xcodeproj",
      scheme: "CalmTrack",
      destination: "generic/platform=iOS Simulator",
      derivedDataPath: "build/DerivedData",
      code_signing: false
    )
  end

  desc "真机 Release archive 并导出 Development 签名 ipa（本机；Automatic signing）"
  lane :archive do
    gym(
      scheme: "CalmTrack",
      clean: true,
      configuration: "Release",
      export_method: "development",
      export_options: {
        method: "development",
        signingStyle: "automatic",
        teamID: "53353F8EY8"
      },
      output_directory: "build/ipa",
      output_name: "CalmTrack"
    )
  end

  desc "构建并编译测试（CI 用；模拟器，无签名）"
  lane :test_build do
    xcodebuild(
      project: "CalmTrack.xcodeproj",
      scheme: "CalmTrack",
      destination: "generic/platform=iOS Simulator",
      derivedDataPath: "build/DerivedData",
      code_signing: false,
      build_for_testing: true
    )
  end
end
