# 复制为 fastlane/.env 并填入真实值（fastlane/.env 已被 .gitignore 忽略，勿提交真实密钥）
#
# 1) App Store Connect API Key
#    创建：App Store Connect → 用户和访问 → 集成 → App Store Connect API → 生成密钥
#    下载的 .p8 文件放到本机任意路径，把路径填到 FILEPATH（例如 ~/Downloads/AuthKey_XXXXXXXXXX.p8）
APP_STORE_CONNECT_API_KEY_KEY_ID=REPLACE_WITH_KEY_ID
APP_STORE_CONNECT_API_KEY_ISSUER_ID=REPLACE_WITH_ISSUER_ID
APP_STORE_CONNECT_API_KEY_FILEPATH=REPLACE_WITH_KEY_FILEPATH

# 2) match 证书仓库（私有 GitHub repo）与加密密码
#    建仓：GitHub → New repository → wsytl/CalmTrack-match-certs（Private）→ 把 git URL 填到下面
MATCH_GIT_URL=REPLACE_WITH_MATCH_CERTS_REPO_URL
MATCH_PASSWORD=REPLACE_WITH_MATCH_PASSWORD
